DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = Libopenpresso
PROJECT_NUMBER         = @LIBOPENPRESSO_VERSION@
PROJECT_BRIEF          = Smart espresso machine control library
PROJECT_LOGO           = @CMAKE_CURRENT_SOURCE_DIR@/logo-light.svg
HTML_OUTPUT            = @DOXYGEN_HTML_DIR@
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@/include @PROJECT_SOURCE_DIR@/docs/pages @CMAKE_CURRENT_BINARY_DIR@
INPUT                  = @DOXYGEN_INPUT@
EXTRACT_ALL            = NO
RECURSIVE              = YES
CASE_SENSE_NAMES       = NO
FILE_PATTERNS          = *.cpp *.hpp *.md *.dox
FULL_PATH_NAMES        = YES
GENERATE_HTML          = YES
GENERATE_XML           = NO
GENERATE_LATEX         = NO 
USE_MATHJAX            = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
SKIP_FUNCTION_MACROS   = NO 
EXPAND_ONLY_PREDEF     = NO
BUILTIN_STL_SUPPORT    = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = @CMAKE_CURRENT_BINARY_DIR@/index.md

HTML_EXTRA_STYLESHEET  = @AWESOME_CSS_DIR@/doxygen-awesome.css \
                         @CMAKE_CURRENT_SOURCE_DIR@/custom.css 

HTML_EXTRA_FILES       = @AWESOME_CSS_DIR@/doxygen-awesome-darkmode-toggle.js \
                         @AWESOME_CSS_DIR@/doxygen-awesome-paragraph-link.js \
                         @CMAKE_CURRENT_SOURCE_DIR@/logo-dark.svg

HTML_HEADER            = @CMAKE_CURRENT_SOURCE_DIR@/header.html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT 


